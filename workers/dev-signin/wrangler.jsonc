// The DEV sign-in Worker (#1262, shyden-labs/repo-template#207). It lives in the
// TEST+DEV account on workers.dev, which people never open (Indonesia blocks it):
// only the `dev-signin.shyden.co.uk` door calls it, with the door secret.
// Secrets, set once with `wrangler secret put`: DOOR_SECRET, DEV_PASS_PRIVATE_JWK.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shyden-dev-signin",
  "main": "index.ts",
  "account_id": "ed8dcf3e1ce9159757f7492bc2d4930d",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // shyden-dev-signin-codes, created by the first deploy (2026-11-25).
  "kv_namespaces": [
    { "binding": "CODES", "id": "fdbdaa524e9a44d98ecc437921fcd77c" },
  ],
  "vars": {
    "DEV_PASS_KID": "2026-11",
    // Read back from Zero Trust (PROD account): the team domain, and the AUD tag of the
    // Access application "dev-signin" on dev-signin.shyden.co.uk (2026-11-25).
    "ACCESS_TEAM_DOMAIN": "https://shyden.cloudflareaccess.com",
    "ACCESS_AUD": "e5c082bb53e48f667ae95dc8d77d8c11c9afc6c1bfc19a67bd14197ec84359a0",
  },
}
