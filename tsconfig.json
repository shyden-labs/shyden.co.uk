{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // `astro/tsconfigs/base` sets `allowJs` but NOT `checkJs`, so every file
    // under `scripts/` was ADMITTED to the program and never had its body
    // read: 4,456 lines across 10 files, including the deploy gate that
    // decides whether `develop` reaches dev and the evidence builder the
    // release sign-off is made from. Measured 2026-09-21: the line
    // `export const typo = import.meta.mian;` appended to
    // `scripts/evidence-files.mjs` produced 0 errors, 0 warnings, 0 hints,
    // while the same line in a `tests/unit/*.ts` file produced ts(2339).
    //
    // Derived from the tree rather than listed: `checkJs` covers every .js
    // and .mjs the program already admits, so a script added next year is
    // checked the day it is written (#228).
    "checkJs": true
  },
  // Astro's base excludes `dist` alone; a local `exclude` replaces that list,
  // so `dist` is repeated here. The other two are test output, git-ignored:
  // a real-device run's HTML report ships Playwright's minified trace viewer,
  // which `checkJs` failed with 14 errors and then a Node abort, refusing a
  // push (#1022).
  "exclude": ["dist", "playwright-report", "test-results"]
}
