# Turns `engines` in package.json from advisory into a hard install failure.
#
# Without this, npm only WARNS when the running Node is below the declared
# floor and installs anyway, so the real failure surfaces much later at build
# or test time as a confusing runtime error. `.nvmrc` pins CI and nvm users but
# npm never reads it, so this is the only place the contract is enforced for a
# contributor on volta, asdf, fnm, or a system Node. See #31.
engine-strict=true

# A stalled request fails at once, naming its URL, and is never retried
# (#929). On 2026-10-22 from about 02:30 to 03:15Z every CI job's `npm ci`
# took 301-303 s instead of 5: npm's defaults retry a failed request twice
# and wait up to 300 s for one, in silence, and sanity-on-build's 5-minute
# limit cancelled every pull request's run. The timeout is measured: over 20
# installs in CI's image (probe run 39731697441) the slowest single request
# took 6.8 s, so 60 s is about nine times that.
fetch-retries=0
fetch-timeout=60000
