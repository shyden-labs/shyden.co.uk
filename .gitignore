# Dependencies
node_modules/

# Astro build output
dist/
.astro/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Playwright's DEFAULT snapshot directory, written only by a config with no
# `snapshotPathTemplate` (#194). Real baselines live in
# tests/e2e/__screenshots__/ and stay committable.
*.spec.ts-snapshots/

# Dashboard state (scripts/dashboard.mjs) -- deliberately OUTSIDE test-results/:
# Playwright's default outputDir behaviour recursively wipes that whole
# directory at the start of EVERY invocation, and desktop + android are
# concurrent Playwright invocations sharing it -- proven live (task 6) to
# destroy files written there by anything meant to survive the whole run.
dashboard-state/

# Cloudflare / wrangler local state
.wrangler/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
.vscode/
.idea/
.superpowers/
# npm run floors:record's scratch directories, on the container's mount (#475)
/.floors-record-*/
.remember/
