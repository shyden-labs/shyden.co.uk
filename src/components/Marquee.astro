---
import { localeNativeNames } from '../lib/i18n/metadata';

/**
 * The Aurora language band (#17), carried across from the Kinetic direction
 * and recoloured into mint so the page reads as one design rather than two.
 *
 * DECORATIVE, and marked so. It is an atmosphere strip, not information: a
 * screen reader gets nothing from a list scrolling past twice, and the
 * languages it names are already available from the switcher in the header.
 *
 * The list is DERIVED from the locales the site serves, where the approved
 * artifact writes it by hand. That means it cannot fall behind a locale that
 * is added, and — the half that matters — it cannot name a language the site
 * does not serve. `tests/unit/marquee.test.ts` pins the endonyms literally.
 *
 * No JavaScript: one CSS keyframe, which the global `prefers-reduced-motion`
 * rule in tokens.css already reduces to a stop. The visitor's OWN way to stop
 * it (#598, WCAG 2.2.2 Pause, Stop, Hide: it moves for far longer than five
 * seconds, and the operating system's setting is not a mechanism the page
 * provides) is a native checkbox beside the band: ticked means paused, and a
 * `:has(:checked)` rule sets `animation-play-state`, so the page still ships
 * only the theme script. The control is a SIBLING of the aria-hidden clip,
 * never inside it, or a screen reader would not find it.
 */
interface Props {
  /** The locale's label for the control: "Pause motion". */
  pauseLabel: string;
}
const { pauseLabel } = Astro.props;
const run = `${localeNativeNames().join(' ✱ ')} ✱ `;

// Two IDENTICAL halves, so translating the track by exactly -50% lands the
// second half where the first began and the loop has no seam. Repeating the
// run inside each half is what keeps a wide viewport covered.
const half = run.repeat(2);
---

<div class="band">
  <label class="band-pause">
    <input type="checkbox" />
    <span>{pauseLabel}</span>
  </label>
  <div class="marquee-clip" aria-hidden="true">
    <div class="marquee">
      <div class="marquee-track">
        <span>{half}</span>
        <span>{half}</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* The band owns its own overflow.
     `.marquee` is rotated AND scaled 1.05 to cover the corners the rotation
     leaves bare, so it paints ~10px outside itself on a narrow viewport —
     `overflow: hidden` on `.marquee` clips its CHILDREN, never the
     transformed element itself. The original note here said "the parent clips
     the overflow", which was a contract with nothing enforcing it: the
     component was written and never wired into a page, so nothing had ever
     tested it. Wiring it into the homepage produced 10px of horizontal scroll
     at every width.

     `clip`, not `hidden`: `hidden` creates a scroll container and would break
     `position: sticky` for anything inside or below it — which this site uses
     on /classroom-groups. `clip` clips without that side effect. */
  .marquee-clip {
    overflow: clip;
  }
  .marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    /* At least as tall as the pill that sits on it (#606), so the pill stays
       inside the band at every width; the text keeps its middle. */
    display: flex;
    align-items: center;
    min-block-size: 44px;
    margin-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding-block: 0.5rem;
    background: var(--accent);
    /* Not --ink: --ink is the page's text colour, and on the accent ground
       it fails AA in both themes (the dark theme's mint is a LIGHT ground).
       --on-accent exists for exactly this (#17); tests/unit/contrast.test.ts
       scores it against --accent, so no ratio is written here. */
    color: var(--on-accent);
    box-shadow: 0 0 50px var(--accent-glow);
    /* The tilt is the point of the band. `scale` covers the corners the
       rotation would otherwise leave bare; the parent clips the overflow,
       which is what keeps a 320px viewport from scrolling sideways. */
    transform: rotate(-1.6deg) scale(1.05);
  }

  .marquee-track {
    display: flex;
    inline-size: max-content;
    animation: marquee-slide 30s linear infinite;
  }

  /* The visitor's pause (#598). Ticked means paused; the rule reads the
     checkbox's state from the DOM, so no script is needed. */
  .band:has(.band-pause input:checked) .marquee-track {
    animation-play-state: paused;
  }

  /* The control is a pill ON the strip (#606), at its inline-end and centred
     on it, where it used to be a 44px row of its own above the strip with
     nothing in it but the checkbox. The band is the positioning context and
     is exactly the strip's height (the strip's margins collapse out of it),
     so `top: 50%` is the strip's middle. It paints above the strip's text
     (z-index 3 over the strip's 2) and BELOW the sticky header (10, #599), so
     the header still covers it after scrolling. A solid --surface ground with
     its own --ink: tests/unit/contrast.test.ts scores that pair. The label is
     the touch target: 44px tall. The ring is the site's global
     :focus-visible one, on the input. */
  .band {
    position: relative;
  }
  .band-pause {
    position: absolute;
    z-index: 3;
    inset-inline-end: var(--space);
    top: 50%;
    translate: 0 -50%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding-block: 0.25rem;
    padding-inline: 0.9rem;
    /* Never wider than half the band: a long label (Vietnamese, Thai) wraps
       onto two even lines inside the pill instead of widening it (#606). */
    max-inline-size: 50%;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.95rem;
    cursor: pointer;
  }
  .band-pause span {
    text-wrap: balance;
  }
  .band-pause input {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    flex: none;
    margin: 0;
    cursor: pointer;
  }

  .marquee-track span {
    padding-inline-end: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(0.9rem, 0.8rem + 0.5vw, 1.15rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* Nothing on paper. The band is already declared decorative and
     aria-hidden — a screen reader gets nothing from it and neither does a
     reader holding a sheet. It was also printing white-on-white: its ink is
     --on-accent, legible only on the mint ground, and a background browsers
     do not print by default. Hiding it settles both at once. */
  @media print {
    .marquee,
    .band-pause {
      display: none;
    }
  }

  @keyframes marquee-slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
