---
// One legal document, rendered (#1080). The text is data (`src/lib/legal/`),
// kept out of every catalogue, written in English and Indonesian alone
// (#1082): the two are each other's alternates, and no other locale has a
// route. The header offers no switcher, whose other links would answer 404;
// each text links to the other in its opening.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalBlocks from '../LegalBlocks.astro';
import type { LegalDocument } from '../../lib/legal/privacy';
import type { Locale } from '../../lib/i18n';

interface Props {
  doc: LegalDocument;
  lang: Locale;
  /** Every locale the document is written in. */
  locales: readonly Locale[];
}
const { doc, lang, locales } = Astro.props;
---

<BaseLayout
  title={doc.title}
  description={doc.description}
  lang={lang}
  localised={false}
  locales={locales}
>
  <article class="legal-doc">
    <h1>{doc.heading}</h1>
    <p class="updated">{doc.updated}</p>
    <LegalBlocks blocks={doc.lead} />
    {doc.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        <LegalBlocks blocks={section.blocks} />
      </section>
    ))}
  </article>
</BaseLayout>
<style is:global>
  /* Global: LegalBlocks' paragraphs and lists carry its scope, not this
     page's. Every rule is held under .legal-doc. */
  .legal-doc {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 4rem var(--space);
    line-height: 1.6;
  }
  .legal-doc h2 {
    margin-top: 2.5rem;
  }
  .legal-doc p,
  .legal-doc ul {
    max-width: 70ch;
  }
  .legal-doc li + li {
    margin-top: 0.5rem;
  }
  .legal-doc a {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .legal-doc .updated {
    color: var(--ink-soft);
  }
</style>
