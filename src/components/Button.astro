---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
}
const { href, variant = 'primary', external = false } = Astro.props;

// Mirrors WorkCard: `noopener` denies the opened page a window.opener handle
// back to ours, `noreferrer` withholds the referrer. Both, or neither.
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a class={`btn ${variant}`} href={href} rel={rel} target={target}>
  <slot />
</a>
<style>
  .btn {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }
  .primary {
    background: var(--accent);
    color: var(--on-accent);
  }
  .primary:hover {
    background: var(--accent-ink);
    color: var(--on-accent);
  }
  .secondary {
    border: 1px solid var(--border-strong);
    color: var(--ink);
  }
</style>
