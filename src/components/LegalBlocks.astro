---
// Paragraphs and lists of a legal document (#1080). Each run of inline text
// is one expression, so no space between a word and its link depends on how
// the formatter wraps the markup.
import type { Block } from '../lib/legal/privacy';

interface Props {
  blocks: readonly Block[];
}
const { blocks } = Astro.props;
---

{blocks.map((block) =>
  block.kind === 'p' ? (
    <p>
      {block.parts.map((part) =>
        typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>,
      )}
    </p>
  ) : (
    <ul>
      {block.items.map((item) => (
        <li>
          {item.map((part) =>
            typeof part === 'string' ? (
              part
            ) : (
              <a href={part.href}>{part.text}</a>
            ),
          )}
        </li>
      ))}
    </ul>
  ),
)}
