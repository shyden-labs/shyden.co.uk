---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { localisePath, type Locale, getSiteStrings } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = getSiteStrings(lang);

// Root-relative (/#…) not bare (#…): the Header renders on every page via
// BaseLayout, but these section anchors live only on the homepage — so bare
// fragments would dead-link on /glory-points and /404. /#shytalk scrolls in
// place on the homepage and navigates home-then-scrolls from any other page.
//
// The home path is locale-aware for the same reason: on /id/* pages a bare
// `/#shytalk` would silently throw the visitor back to the ENGLISH homepage,
// which looks like the site forgetting their language mid-visit.
const home = localisePath('/', lang);
const base = home === '/' ? '' : home.replace(/\/$/, '');
const links = [
  { href: `${base}/#shytalk`, label: t.nav.shytalk },
  { href: `${base}/#yawelo-idle`, label: t.nav.yaweloIdle },
  { href: `${base}/#tools`, label: t.nav.tools },
  { href: `${base}/#contact`, label: t.nav.contact },
];
---

<header>
  <div class="bar">
    <a class="wordmark" href={home}>
      Shyden
    </a>
    <details class="menu">
      <summary aria-label={t.menuLabel} aria-controls="primary-nav">
        <span class="bars"></span>
      </summary>
    </details>
    {/* The theme switch and the language switcher are ONE item in the bar
        (#142 §5). The bar spaces its items with `space-between`, so a fourth
        separate item would float in the middle of the row on a wide screen
        rather than sit beside the language switcher. Both live in the BAR,
        not in <nav>, for two reasons, both learned from a failing test.
        <nav> means "the site's sections" and is pinned to exactly those
        links; these controls are a different kind of thing. And on
        mobile <nav> collapses behind the menu button, which would hide them
        from exactly the visitors most likely to want them. */}
    <div class="controls">
      <ThemeSwitch lang={lang} />
      <LanguageSwitcher lang={lang} pathname={Astro.url.pathname} />
    </div>
    <nav id="primary-nav">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    position: relative;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0.75rem var(--space);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    /* Never shrinks. `min-width: 44px` below is a touch-target floor, and an
       explicit min-width replaces flex's automatic minimum (the text's own
       width). So when the row ran out of room, flex could squeeze this box
       to 60px while "Shyden" still needed 73.6px, and the word ran under the
       menu button (#329). */
    flex: none;
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  /* No gap: the switch's 44px box already holds its 24px icon 10px clear of
     the language switcher. At 320px the Thai row has 2.97px to spare on
     Linux Firefox, whose Thai label is 10px wider than Chromium's, and a
     0.25rem gap ran the label 1px outside the row (header-room.spec.ts). */
  .controls {
    display: flex;
    align-items: center;
  }
  /* Mobile disclosure toggle (the hamburger). */
  .menu > summary {
    list-style: none;
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ink);
    content: '';
  }
  .bars {
    position: relative;
  }
  .bars::before {
    position: absolute;
    top: -7px;
  }
  .bars::after {
    position: absolute;
    top: 7px;
  }
  /* The nav lives OUTSIDE <details> so that at desktop it is a plain flex
     element (a closed <details> wrapper collapses to 0 width and pushes its
     children off-screen on every engine). On mobile it is hidden until the
     disclosure opens, then shown as an absolutely-positioned dropdown. */
  nav {
    display: none;
  }
  @media (max-width: 719.98px) {
    .menu[open] ~ nav {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem var(--space);
    }
  }
  nav a {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 720px) {
    .menu {
      display: none;
    }
    nav {
      display: flex;
      flex-direction: row;
      gap: 1.5rem;
      position: static;
      padding: 0;
    }
  }
</style>
