---
import {
  type Locale,
  BETA_BADGE,
  getSiteStrings,
  isBetaLocale,
} from '../lib/i18n';
import { pageIdFromPath } from '../lib/report';
import ReportForm from './ReportForm.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = getSiteStrings(lang);

// Assembled in the frontmatter, not the template: written inline as two
// expressions with a newline between them, JSX drops the space and this
// renders as "BETATranslations may not be accurate." Building it here makes
// the rendered sentence independent of how the markup wraps.
//
// The footer names no company (#370): Shyden Ltd is dissolved, and its
// registration, number and office left every page with it.
//
// Null on English, which is the one locale Shyden can confirm verified --
// a notice on every page would say nothing, and would make the marker
// meaningless where it matters.
const betaNotice = isBetaLocale(lang)
  ? `${BETA_BADGE} — ${t.language.betaNotice}`
  : null;

// The report form (#97): the page comes from the route, so no page has to
// remember a prop, and ReportForm decides through isBetaLocale whether to
// draw. A path the table does not know renders no form, and the presence
// check in report-presence.spec.ts fails on it rather than letting it go
// quietly.
const reportPage = pageIdFromPath(Astro.url.pathname);
---

<footer id="contact-legal">
  <div class="inner">
    {betaNotice && (
      <p class="beta-notice" data-beta-notice>
        {betaNotice}
      </p>
    )}
    {reportPage && <ReportForm lang={lang} page={reportPage} />}
    <p>
      <a href="mailto:support@shyden.co.uk">support@shyden.co.uk</a>
    </p>
  </div>
</footer>
<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 2rem var(--space);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .inner a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--accent);
  }
</style>
