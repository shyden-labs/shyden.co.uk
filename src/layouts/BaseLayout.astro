---
import '../styles/tokens.css';
import themeScript from '../scripts/theme.inline.js?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  LOCALES,
  localisePath,
  localeFromPath,
  type Locale,
  getSiteStrings,
} from '../lib/i18n';
import { metadataFor } from '../lib/i18n/metadata';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Defaults to the locale implied by the URL, so pages rarely pass it. */
  lang?: Locale;
  /**
   * A page that is not a real URL. Suppresses canonical and hreflang and asks
   * not to be indexed — for the 404, which is served for any unknown path and
   * therefore has no address of its own to be canonical about.
   */
  noIndex?: boolean;
  /**
   * False for a page served in English only (the API docs, #781): the header
   * then offers no language switcher, whose links would lead to pages that do
   * not exist.
   */
  localised?: boolean;
}
const {
  title,
  description,
  ogImage = '/og-default.png',
  lang = localeFromPath(Astro.url.pathname),
  noIndex = false,
  localised = true,
} = Astro.props;
const site = getSiteStrings(lang);
const siteOrigin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;

// hreflang for BOTH locales plus x-default. Without these, search engines
// treat the English and Indonesian pages as unrelated near-duplicates rather
// than translations of one another, and may index only one of them.
const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(localisePath(Astro.url.pathname, code), siteOrigin).href,
}));
const xDefault = new URL(localisePath(Astro.url.pathname, 'en'), siteOrigin)
  .href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The theme script (#142 §5). Inline, classic and HERE, straight after
         the viewport meta and before every stylesheet, because it stamps a
         saved choice on <html> before the first paint: a visitor who chose
         light never sees a frame of dark, or the reverse. A module, `defer`
         or a later place in the document would all run after that frame.
         It also reveals the switch, which exists only for a page whose script
         ran, and handles its presses by delegation, since the switch does
         not exist yet when a head script runs.

         Its explanation lives here, where the build strips it, and not in the
         shipped file, which every page carries exactly as written. The site
         sends no Content-Security-Policy; one added later must allow this
         script by its hash, which changes only when the file does, and
         theme-script.spec.ts pins the content. The choice is one
         localStorage word, written only when the switch is pressed: no
         cookie, and nothing sent anywhere. Where storage is refused, the save
         is skipped in silence and the page still switches; the choice is
         simply not remembered (§5), which is what the script's one empty
         catch is for. */}
    <script is:inline set:html={themeScript}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /* The 404 emitted `canonical=/404/` and `hreflang=id → /id/404/`, and
         neither is a page that exists. Nothing catastrophic, since the
         response is a 404 — but it is unmanaged head output on a live site,
         pointing search engines at two URLs that do not resolve and do not
         reciprocate. */
      noIndex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.code} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {/* Same reasoning as the canonical: a page served for every unknown path
        has no og:url to give, and /404/ is not one. */}
    {!noIndex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(ogImage, siteOrigin).href} />
    <meta property="og:locale" content={metadataFor(lang).ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    {/* WCAG 2.4.1. The copy for this existed in both languages from the
        start while no page had the link, which made the repo look like it
        had met the criterion. It bites hardest on /classroom-groups, the
        most control-dense page here: without it a keyboard user crosses the
        wordmark, the hamburger, the language switcher and three nav links
        before reaching the first form field, on every single page load. */}
    <a class="skip-link" href="#main">
      {site.skipToContent}
    </a>
    <Header lang={lang} localised={localised} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
