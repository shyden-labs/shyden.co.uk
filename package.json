{
  "name": "shyden-co-uk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=1 astro dev",
    "build": "astro build",
    "preview": "ASTRO_PREVIEW_BACKGROUND=1 astro preview",
    "typecheck": "astro check --minimumFailingSeverity hint",
    "lint:tests": "node scripts/lint-changed-tests.mjs",
    "test:unit": "vitest run --configLoader native",
    "test:coverage": "NODE_V8_COVERAGE=\"$PWD/coverage/raw/vitest-main\" vitest run --configLoader native --config vitest.coverage.config.ts --coverage",
    "test:coverage:simulation": "NODE_V8_COVERAGE=\"$PWD/coverage/raw/vitest-main\" vitest run --configLoader native --config vitest.simulation.config.ts --coverage --testTimeout=0",
    "test:coverage:integration": "NODE_V8_COVERAGE=\"$PWD/coverage/raw/vitest-main\" COVERAGE_CHILD_PROCESSES=\"$PWD/coverage/raw/integration\" npm run test:integration -- --coverage",
    "test:guards": "vitest run --configLoader native --config vitest.guards.config.ts --testTimeout=25000",
    "test:simulation": "vitest run --configLoader native --config vitest.simulation.config.ts --testTimeout=700",
    "test:integration": "vitest run --configLoader native --config vitest.integration.config.ts --testTimeout=30000",
    "test:logs": "vitest run --configLoader native --config vitest.logs.config.ts --testTimeout=1000",
    "floors:record": "node scripts/record-floors.mjs",
    "ceilings:record": "node scripts/record-ios-ceilings.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:functions": "playwright test --config=playwright.functions.config.ts",
    "test:sanity": "SANITY_ON_BUILD=1 playwright test -c playwright.dev.config.ts && SANITY_ON_BUILD=1 playwright test -c playwright.prod.config.ts",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update",
    "test:ios": "vitest run --configLoader native --config vitest.ios.config.ts --reporter=verbose",
    "test:devices": "node scripts/test-devices.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:back-translate": "node scripts/i18n-back-translate.mjs",
    "i18n:google-read-back": "node scripts/i18n-google-read-back.mjs",
    "i18n:read-back-verdicts": "node scripts/i18n-read-back-verdicts.mjs",
    "i18n:second-read": "node scripts/i18n-second-read.mjs",
    "reports:review": "node scripts/reports-review.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "test": "npm run format && npm run typecheck && npm run test:unit",
    "format": "prettier --check .",
    "i18n:scaffold": "node scripts/i18n-scaffold.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^7.3.6",
    "swagger-ui-dist": "5.33.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "ast-v8-to-istanbul": "1.0.7",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.155.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "http-cache-semantics": "4.2.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261023.1": true
  },
  "scarfSettings": {
    "enabled": false
  }
}
