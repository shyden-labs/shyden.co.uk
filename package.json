{
  "name": "shyden-co-uk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=1 astro dev",
    "build": "astro build",
    "preview": "ASTRO_PREVIEW_BACKGROUND=1 astro preview",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose --testTimeout=30000",
    "floors:record": "node scripts/record-floors.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:functions": "playwright test --config=playwright.functions.config.ts",
    "test:sanity": "SANITY_ON_BUILD=1 playwright test -c playwright.dev.config.ts && SANITY_ON_BUILD=1 playwright test -c playwright.prod.config.ts",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update",
    "test:ios": "vitest run --config vitest.ios.config.ts --reporter=verbose",
    "test:devices": "node scripts/test-devices.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:back-translate": "node scripts/i18n-back-translate.mjs",
    "reports:review": "node scripts/reports-review.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "format": "prettier --check .",
    "i18n:scaffold": "node scripts/i18n-scaffold.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "4.144.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "http-cache-semantics": "4.2.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260926.1": true
  }
}
